# CONTROLADOR DE ENTORNO: Cambia a 'test' para usar MOCKS o a 'local' para simular Docker
# o 'json-db' para escribir en un archivo json
NODE_ENV=json-db

# CONFIGURACIÓN PARA LOS MOCKS (Solo se activa si NODE_ENV=test)
SCENARIO_FILE=exitoso.json

# CONFIGURACIÓN REAL DE TU CONTENEDOR DOCKER POSTGRES (Se activa si NODE_ENV=local)
DB_HOST=localhost
DB_PORT=5436
DB_USER=localdb
DB_PASS=Abc12345
DB_NAME=localdb
# Puertos de los enpoints
PORT=3001